# ─── Telegram ────────────────────────────────────────────────────────────────
# Токен от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789

# ─── Хранилище ───────────────────────────────────────────────────────────────
DB_PATH=bot_data.db
DOWNLOAD_DIR=downloads

# ─── Лимиты ──────────────────────────────────────────────────────────────────
# Лимит Telegram — 50 МБ, берём с запасом
MAX_FILE_SIZE_MB=49
# Параллельных загрузок одновременно
MAX_WORKERS=15
# Максимум задач в очереди
MAX_QUEUE_SIZE=500
# Задач от одного пользователя одновременно
MAX_USER_TASKS=2
# Секунд на одну загрузку
DOWNLOAD_TIMEOUT=180
# Секунд ожидания в очереди, после чего задача отбрасывается
MAX_WAIT_TIME=600
# Минимальный интервал между сообщениями одного пользователя, мс
THROTTLE_MS=700

# ─── Прочее ──────────────────────────────────────────────────────────────────
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# ru / en / uz
DEFAULT_LANG=ru
# Отдавать повторные ссылки по кэшу file_id (без повторного скачивания)
FILE_CACHE_ENABLED=true
# Период записи активности пользователей в БД, сек
USER_FLUSH_INTERVAL=30
